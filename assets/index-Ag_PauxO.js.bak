 and show you how you can break down a website that inspires you into a self-learning plan so you have an order and structure to learn from.","Soon, you will be able to make the website you want!!! Just believe in yourself and stick to the plan! You got this 💪💪💪!!! I was very very slow and confused when I first started programming. If you're a newer programmer, the only difference between me and you is time!"]}]},three:{name:"Video",imageUrl:"/images/multiplayer-game.webp",externalLink:"https://www.youtube.com/watch?v=6QdkIOo-fe0",content:[{header:"About the Video",paragraphs:["Ever wanted to make a multiplayer game? In this video I describe how to make a fairly simple multiplayer game with a limited tech stack. It's not paticularly robust for larger games, but for a prototyping workflow it definitely works out well. Some concepts also transfer over to larger projects though."]},{header:"Tech featured in video",paragraphs:[" - Squoosh"," - Heroku"," - three.js"," - Blender"]}]},four:{name:"Video",imageUrl:"/images/immersive-world.webp",externalLink:"https://youtu.be/C4g2U2ZYbZ4",content:[{header:"About the Video",paragraphs:["This video is outdated 😳😳 but I left it in here... woops haha. I cover a little bit about octree and first person controls."]}]}},n3=({projectID:r})=>{const e=t3[r];return e?U.jsxs("div",{className:"project-container",children:[U.jsx("div",{className:"project-image-wrapper",children:U.jsx("img",{src:e.imageUrl,alt:e.name,className:"project-image"})}),U.jsxs(Tg,{href:e.externalLink,type:"link",children:["Watch ",e.name]}),e.content.map((t,n)=>U.jsxs("div",{className:"project-section",children:[U.jsx("h2",{className:"project-section-header",children:t.header}),t.paragraphs.map((i,s)=>U.jsx("p",{className:"section-paragraph",children:i},`${n}-${s}`))]},n))]}):U.jsx("div",{children:"Project not found"})};function i3({progress:r=0,pulseIntensity:e=0,...t}){const{nodes:n,materials:i}=Oo("/models/DetailT-v1.glb"),[s,a]=Fe.useState(null),{openModal:c}=